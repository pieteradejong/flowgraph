# Local Supabase (run `supabase start` then copy values from `supabase status`).
# Copy this file to `.env.local` (gitignored) and fill in the keys.
#
# These values are local-only — they have no meaning off your machine.
# Hosted Supabase is intentionally out of scope (see docs/ARCHITECTURE.md).

# API URL matches `[api].port` in supabase/config.toml (55321 avoids clash with another local Supabase on 54321).
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=
